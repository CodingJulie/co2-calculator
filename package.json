{
  "name": "@ecotrackr/co2-calculator",
  "version": "1.0.1",
  "description": "CO2 Calculator component for EcoTrackr - calculate and track carbon footprint",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external react-dom --external recharts --external lucide-react --external framer-motion",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external react-dom --external recharts --external lucide-react --external framer-motion",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "release": "commit-and-tag-version",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run"
  },
  "peerDependencies": {
    "framer-motion": "^10.0.0",
    "lucide-react": "^0.200.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "commit-and-tag-version": "^12.7.3",
    "framer-motion": "^10.0.0",
    "jsdom": "^24.0.0",
    "lucide-react": "^0.200.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "co2",
    "carbon-footprint",
    "calculator",
    "ecotrackr",
    "react",
    "typescript"
  ],
  "author": "EcoTrackr Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Julie-Trifonova/co2-calculator.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
